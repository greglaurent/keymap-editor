# Copy to .env (just setup does this). The server, just and compose read it.
# Local zmk-config repo to read and write. Relative paths resolve from here.
ZMK_CONFIG_PATH=../zmk-config
# Port the server and Docker listen on, on this computer only.
PORT=4710
# Docker only: the user the container runs as (run `id -u` and `id -g`).
LOCAL_UID=1000
LOCAL_GID=1000
